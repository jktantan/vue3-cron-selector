{
  "name": "vue3-cron-selector",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "A visual cron expression selector component for Vue 3 with inline and panel modes",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "cron",
    "cron-expression",
    "cron-selector",
    "crontab",
    "quartz",
    "spring",
    "scheduler",
    "component"
  ],
  "author": "tantan",
  "homepage": "https://jktantan.github.io/vue3-cron-selector/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/vue3-cron-selector.git"
  },
  "bugs": {
    "url": "https://github.com/jktantan/vue3-cron-selector/issues"
  },
  "main": "./dist/vue3-cron-selector.umd.cjs",
  "module": "./dist/vue3-cron-selector.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-cron-selector.js",
      "require": "./dist/vue3-cron-selector.umd.cjs"
    },
    "./style.css": "./dist/vue3-cron-selector.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -p tsconfig.app.json --noEmit && vite build --mode lib && sass --no-source-map --style=compressed src/lib/theme/index.scss dist/vue3-cron-selector.css",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
